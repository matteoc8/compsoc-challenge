# Copy to .env and fill in. Never commit .env.

# Public address. A real domain gets HTTPS automatically; ":80" = plain HTTP on a LAN.
SITE_ADDRESS=:80
# Set to true when SITE_ADDRESS is an HTTPS domain (sends the session cookie with Secure).
COOKIE_SECURE=false

POSTGRES_PASSWORD=change-me
# 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Seeded admin account; you'll be asked to change the password on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Judge0: self-hosted (default) ...
JUDGE_BACKEND=judge0
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=change-me-judge0-token
# Python's language id on your Judge0 (GET /languages). 71 = Python 3.8.1 on Judge0 CE.
JUDGE0_PYTHON_ID=71
# ... or the hosted fallback on RapidAPI (switching is config-only):
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_RAPIDAPI_KEY=...
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

SEED_SAMPLE_QUIZ=true

# Problem of the week: entries need an email at exactly this domain (empty = any email),
# and this address is shown when someone can't enter (wrong name for an email, or banned).
SCHOOL_EMAIL_DOMAIN=stpaulsschool.org.uk
CONTACT_EMAIL=carriem@stpaulsschool.org.uk

# Optional: reply to people who submit problems straight from the site, from your own account.
# Gmail: turn on 2-Step Verification, create an App Password (Google Account > Security >
# App passwords) and use it here, not your normal password. Leave SMTP_HOST empty to have the
# site open your own email app instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password
# SMTP_FROM_NAME=CompSoc
